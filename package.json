{
  "name": "loom-core",
  "version": "0.1.0",
  "description": "Build interactive network diagrams and knowledge graphs in TypeScript with WebGL2, force-directed layouts, editable scenes and SQLite/WASM cluster loading.",
  "license": "MIT",
  "homepage": "https://castlemilk.github.io/loom/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/castlemilk/loom.git"
  },
  "bugs": "https://github.com/castlemilk/loom/issues",
  "keywords": ["graph-visualization", "network-diagram", "knowledge-graph", "graph-editor", "force-directed-graph", "webgl2", "typescript", "sqlite", "webassembly"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "proto",
    "README.md",
    "docs/editor-api.md",
    "docs/examples",
    "benchmarks/m2-max.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./editor.schema.json": "./dist/editor.schema.json",
    "./api-index.json": "./dist/api-index.json",
    "./wire-effects.schema.json": "./dist/wire-effects.schema.json",
    "./drawing-style.schema.json": "./dist/drawing-style.schema.json",
    "./wires": {
      "types": "./dist/wires.d.ts",
      "import": "./dist/wires.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js"
    },
    "./layout-worker.js": "./dist/layout-worker.js",
    "./drilldown": {
      "types": "./dist/drilldown.d.ts",
      "import": "./dist/drilldown.js"
    },
    "./explore": {
      "types": "./dist/explore.d.ts",
      "import": "./dist/explore.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./atlas-map": {
      "types": "./dist/atlas-map.d.ts",
      "import": "./dist/atlas-map.js"
    },
    "./wikipedia-images": {
      "types": "./dist/wikipedia-images.d.ts",
      "import": "./dist/wikipedia-images.js"
    },
    "./atlas-sqlite": {
      "types": "./dist/atlas-sqlite.d.ts",
      "import": "./dist/atlas-sqlite.js"
    },
    "./atlas-runtime/*": "./dist/atlas-runtime/*",
    "./cards": {
      "types": "./dist/cards.d.ts",
      "import": "./dist/cards.js"
    },
    "./clusters": {
      "types": "./dist/clusters.d.ts",
      "import": "./dist/clusters.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/performance.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "import": "./dist/taxonomy.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc && node scripts/api-index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/unit.mjs",
    "test:types": "tsc --strict --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext tests/public-api.ts docs/examples/*.ts",
    "test:browser": "node scripts/browser.mjs",
    "test:package": "node scripts/check-package.mjs",
    "bench": "node scripts/browser.mjs --bench",
    "bench:contours": "node scripts/measure-contours.mjs",
    "size": "node scripts/size.mjs",
    "dev": "node scripts/serve.mjs",
    "demo:build": "node scripts/build-studio.mjs",
    "site:dev": "npm --prefix web run dev",
    "site:build": "npm --prefix web run build",
    "package:site": "npm pack --pack-destination web/out",
    "test:site": "node scripts/test-site.mjs",
    "test:dev": "playwright test --config tests/dev.config.mjs",
    "prepack": "npm run build && npm run size"
  },
  "devDependencies": {
    "comlink": "4.3.0",
    "esbuild": "0.25.12",
    "playwright": "1.60.0",
    "sql.js-httpvfs": "0.8.12",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
