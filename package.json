{
  "name": "loom-core",
  "version": "0.1.0",
  "private": true,
  "description": "An instanced WebGL2 graph renderer with a sleeping force layout",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "proto",
    "README.md",
    "docs/editor-api.md",
    "benchmarks/m2-max.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./editor.schema.json": "./dist/editor.schema.json",
    "./wire-effects.schema.json": "./dist/wire-effects.schema.json",
    "./drawing-style.schema.json": "./dist/drawing-style.schema.json",
    "./wires": {
      "types": "./dist/wires.d.ts",
      "import": "./dist/wires.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "import": "./dist/console.js"
    },
    "./layout-worker.js": "./dist/layout-worker.js",
    "./drilldown": {
      "types": "./dist/drilldown.d.ts",
      "import": "./dist/drilldown.js"
    },
    "./explore": {
      "types": "./dist/explore.d.ts",
      "import": "./dist/explore.js"
    },
    "./clusters": {
      "types": "./dist/clusters.d.ts",
      "import": "./dist/clusters.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/performance.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "import": "./dist/taxonomy.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/unit.mjs",
    "test:types": "tsc --strict --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext tests/public-api.ts",
    "test:browser": "node scripts/browser.mjs",
    "bench": "node scripts/browser.mjs --bench",
    "bench:contours": "node scripts/measure-contours.mjs",
    "size": "node scripts/size.mjs",
    "dev": "node scripts/serve.mjs",
    "demo:build": "node scripts/build-studio.mjs",
    "site:dev": "npm --prefix web run dev",
    "site:build": "npm --prefix web run build",
    "package:site": "tsc && npm pack --ignore-scripts --pack-destination web/out",
    "test:site": "node scripts/test-site.mjs",
    "prepack": "npm run build && npm run size"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.60.0",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
